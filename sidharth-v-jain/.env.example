# Backend configuration
APP_NAME=DevDigest API
APP_VERSION=0.4.0
APP_ENV=development

# Streamlit -> FastAPI URL
BACKEND_URL=http://127.0.0.1:8000

# GitHub API (optional for public repositories; recommended for higher rate limits)
GITHUB_TOKEN=

# Groq (used by Research Assistant and later CrewAI agents)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ChromaDB and RAG configuration
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=devdigest_research
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RAG_TOP_K=5
MAX_PDF_SIZE_MB=15
